{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "mcp": {
    "drive": {
      "type": "remote",
      "url": "https://drivemcp.googleapis.com/mcp/v1",
      "oauth": {
        "clientId": "{env:GOOGLE_DRIVE_MCP_CLIENT_ID}",
        "clientSecret": "{env:GOOGLE_DRIVE_MCP_CLIENT_SECRET}"
      },
      "enabled": false
    },
    "drive-local": {
      "type": "local",
      "command": [
        "node",
        "/Users/racso/.agents/mcp/drive-local/server.mjs"
      ],
      "enabled": true
    },
    "mcp-server-linkedin": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-linkedin@latest"
      ]
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "trello": {
      "type": "local",
      "command": [
        "bunx",
        "@delorenj/mcp-server-trello"
      ],
      "environment": {
        "TRELLO_API_KEY": "{env:TRELLO_API_KEY}",
        "TRELLO_TOKEN": "{env:TRELLO_TOKEN}"
      },
      "enabled": true
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js"
  ]
}
